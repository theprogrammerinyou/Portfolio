---
import Hamburger from "./Hamburger";

const links = [
  { label: "Work", link: "/#work" },
  { label: "Projects", link: "/projects" },
  { label: "Contact", link: "/contact" },
];
---

<header class="sticky top-0 z-40 border-b border-white/5 bg-ink/70 backdrop-blur-xl">
  <nav class="mx-auto flex max-w-6xl items-center px-5 py-4 md:px-8">
    <a href="/" class="font-display text-lg font-bold tracking-tight text-white md:text-xl">
      Shivansh<span class="text-lime">.</span>
    </a>
    <ul class="ml-10 hidden items-center gap-7 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.link}
              class="text-sm text-mist/70 transition hover:text-lime"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="ml-auto hidden items-center gap-4 md:flex">
      <a
        href="https://github.com/theprogrammerinyou"
        target="_blank"
        rel="noreferrer"
        class="text-sm text-mist/70 hover:text-white"
      >
        GitHub
      </a>
      <a
        href="https://www.linkedin.com/in/shivansh-s-472710134/"
        target="_blank"
        rel="noreferrer"
        class="rounded-full border border-lime/40 bg-lime/10 px-4 py-1.5 text-sm text-lime transition hover:bg-lime hover:text-ink"
      >
        LinkedIn
      </a>
    </div>
    <Hamburger client:load links={links} className="ml-auto md:hidden" />
  </nav>
</header>
