---
interface Props {
  title: string;
  description: string;
  tags: string[];
  imageSrc?: string;
  imageAlt?: string;
  href: string;
  timestamp: Date;
  featured?: boolean;
}

const { title, description, tags, imageSrc, imageAlt, href, timestamp, featured } =
  Astro.props;
---

<a
  href={href}
  class="project-card group glass relative flex h-full flex-col overflow-hidden rounded-3xl transition duration-300 hover:-translate-y-2 hover:border-lime/50"
>
  <div class="relative aspect-[16/9] overflow-hidden">
    {
      imageSrc ? (
        <img
          src={imageSrc}
          alt={imageAlt || title}
          class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
          loading="lazy"
        />
      ) : (
        <div class="flex h-full items-center justify-center bg-gradient-to-br from-violet/40 via-ink to-aqua/30 font-display text-3xl text-white/80">
          {title.slice(0, 2)}
        </div>
      )
    }
    {
      featured && (
        <span class="absolute left-3 top-3 rounded-full bg-lime px-3 py-1 text-xs font-semibold text-ink">
          Featured
        </span>
      )
    }
  </div>
  <div class="flex flex-1 flex-col p-5">
    <div class="mb-3 flex flex-wrap gap-2">
      {
        tags.slice(0, 4).map((tag) => (
          <span class="rounded-full border border-white/10 px-2.5 py-1 text-[11px] uppercase tracking-wide text-mist/70">
            {tag}
          </span>
        ))
      }
    </div>
    <h3 class="font-display text-xl font-bold">{title}</h3>
    <p class="mt-1 text-xs text-mist/50">{timestamp.toDateString()}</p>
    <p class="mt-3 flex-1 text-sm leading-relaxed text-mist/80">{description}</p>
    <span class="mt-4 text-sm text-lime">Open case study <span class="inline-block transition group-hover:translate-x-1">→</span></span>
  </div>
</a>
