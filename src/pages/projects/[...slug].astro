---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ButtonLink from "../../components/ButtonLink.astro";

export async function getStaticPaths() {
  const blogEntries = await getCollection("project");
  return blogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={`Shivansh Shukla | ${entry.data.title}`}>
  <a href="/projects" class="text-sm text-mist/60 hover:text-lime">← All work</a>
  <div class="mt-6 overflow-hidden rounded-[2rem] border border-white/10">
    {
      entry.data.image.src && (
        <img
          src={entry.data.image.src}
          alt={entry.data.image.alt}
          class="max-h-[420px] w-full object-cover"
        />
      )
    }
  </div>
  <p class="mt-6 font-mono text-xs uppercase tracking-[0.2em] text-aqua">
    {new Date(entry.data.timestamp).toDateString()}
  </p>
  <h1 class="mt-2 font-display text-4xl font-bold">{entry.data.title}</h1>
  <div class="mt-4 flex flex-wrap gap-2">
    {
      entry.data.tags.map((tag: string) => (
        <span class="rounded-full border border-white/10 px-3 py-1 text-xs text-mist/70">
          {tag}
        </span>
      ))
    }
  </div>
  <div class="mt-6 flex flex-wrap gap-3">
    {entry.data.demoLink && <ButtonLink label="Live demo" link={entry.data.demoLink} />}
    {
      entry.data.codeLink && (
        <ButtonLink label="Source" link={entry.data.codeLink} variant="ghost" />
      )
    }
  </div>
  <div class="prose mt-10 max-w-none">
    <Content />
  </div>
</Layout>
