---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";

const sortedProjects = (await getCollection("project")).sort(
  (a, b) =>
    new Date(b.data.timestamp).getTime() - new Date(a.data.timestamp).getTime()
);
---

<Layout title="Shivansh Shukla | Projects">
  <p class="font-mono text-xs uppercase tracking-[0.2em] text-lime">Project index</p>
  <h1 class="mt-2 font-display text-4xl font-bold">Projects</h1>
  <p class="mt-3 max-w-3xl text-lg leading-relaxed text-mist/70">
    A mix of production-minded experiments and product builds: mobile apps,
    real-time device control, search-backed learning, developer tooling, and
    interfaces designed to make complicated systems feel simple. Each project
    is a chance to pair a useful idea with a satisfying interaction.
  </p>
  <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {
      sortedProjects.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          tags={project.data.tags}
          imageSrc={project.data.image.src}
          imageAlt={project.data.image.alt}
          href={"/projects/" + project.slug}
          timestamp={project.data.timestamp}
          featured={project.data.featured}
        />
      ))
    }
  </div>
</Layout>
